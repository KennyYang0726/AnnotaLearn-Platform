# PostgreSQL
# Must match docker-compose.yml for local development.
DATABASE_URL="postgresql://annotalearn:annotalearn@localhost:5432/annotalearn?schema=public"

# Session signing. Replace with a random value of at least 32 characters.
SESSION_SECRET="replace-this-with-at-least-32-random-characters"

# Initial ADMIN account. Only used by `npm run db:seed`.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="ChangeThisAdminPassword!"

# Local development: local | Vercel: blob
STORAGE_DRIVER="local"
NEXT_PUBLIC_STORAGE_DRIVER="local"

# Local PDF directory (relative to project root)
LOCAL_STORAGE_DIR="storage/uploads"

# Vercel Private Blob only. Automatically supplied when a Blob store is connected.
BLOB_READ_WRITE_TOKEN=""
