# PostgreSQL used by Docker Compose.
POSTGRES_USER="annotalearn"
POSTGRES_PASSWORD="annotalearn"
POSTGRES_DB="annotalearn"
POSTGRES_PORT="5432"

# Session signing. Replace with a random value of at least 32 characters.
SESSION_SECRET="replace-this-with-at-least-32-random-characters"

# Application timezone for course times, displays, and daily analytics.
# IANA timezone name. Default: Taiwan (UTC+8).
APP_TIMEZONE="Asia/Taipei"

# Initial ADMIN account. Used by the first db:seed.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="ChangeThisAdminPassword!"

# Host port exposed by Docker Compose.
APP_PORT="3000"
